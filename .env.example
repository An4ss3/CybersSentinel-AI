# CyberSentinel AI — local environment template
#
#   cp .env.example .env      # then replace every change_me value
#
# The real .env is git-ignored and must never be committed.
# docker-compose.yml refuses to start PostgreSQL or Grafana without a password.

# ---- PostgreSQL (alert store, canonical evidence chain) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cybersentinel
POSTGRES_USER=cybersentinel
POSTGRES_PASSWORD=change_me_in_local_env

# ---- Grafana (alert dashboard) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_local_env
