# CyberSentinel AI — environment template
# Copy to .env and adjust. NEVER commit the real .env.

# ---- PostgreSQL (alerts / metadata) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cybersentinel
POSTGRES_USER=cybersentinel
POSTGRES_PASSWORD=change_me_in_local_env

# ---- Elasticsearch / Kibana (logs) ----
ELASTIC_HOST=localhost
ELASTIC_PORT=9200
# For the dev lab, security is disabled (see docker-compose). Do NOT do this in prod.
ELASTIC_PASSWORD=change_me_in_local_env

# ---- Redis (cache + Redis Streams message bus) ----
# MVP decision (encadrant): Redis Streams is the bus — no Kafka broker.
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- GenAI SOC Assistant (module 6.6) — leave blank until iteration 2 ----
# Provider API keys are read from the environment; do not hardcode them.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Threat Intelligence (module 6.5) ----
# NVD API key is optional but raises rate limits. Request at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_local_env
